<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:wpfapp.ui.usecase"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit" x:Class="wpfapp.ui.usecase.SwUseCaseCmdInfoPanel"
        mc:Ignorable="d"
        Title="添加命令" Height="750" Width="800">
    <Grid>
        <Label Content="名称:" HorizontalAlignment="Left" Margin="45,11,0,0" VerticalAlignment="Top"/>
        <Label Content="参数:" HorizontalAlignment="Left" Margin="46,42,0,0" VerticalAlignment="Top"/>
        <ComboBox x:Name="comboBoxCmd" 
                  DisplayMemberPath="CmdTypeName"
                  SelectedValuePath="CmdTypeId"
                  SelectionChanged="comboBoxCmd_SelectionChanged" HorizontalAlignment="Left" Margin="115,11,0,0" VerticalAlignment="Top" Width="618"/>

        <xctk:PropertyGrid x:Name="propertyGridCmd" Margin="115,54,60.6,57.8"/>
        <Button x:Name="btnOk" Content="确定" Click="btnOk_Click" HorizontalAlignment="Left" Margin="261,677,0,0" VerticalAlignment="Top" Width="75"/>
        <Button x:Name="btnCancel" Content="取消" Click="btnCancel_Click" HorizontalAlignment="Left" Margin="444,677,0,0" VerticalAlignment="Top" Width="75"/>

    </Grid>
</Window>
