<Window x:Class="wpfapp.ui.usecase.SwUseCaseStepInfoPanel"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:wpfapp.ui.usecase"
        mc:Ignorable="d"
        Title="新增步骤" Height="710" Width="760">
    <Grid>
        <Label Content="名称:" HorizontalAlignment="Left" Margin="9,11,0,0" VerticalAlignment="Top"/>
        <TextBox x:Name="txtName" HorizontalAlignment="Left" Height="23" Margin="85,11,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="629"/>
        <Label Content="命令:" HorizontalAlignment="Left" Margin="10,42,0,0" VerticalAlignment="Top"/>
        <Button x:Name="btnAddCmd" Content="添加命令" Click="btnAddCmd_Click" HorizontalAlignment="Left" Margin="85,48,0,0" VerticalAlignment="Top" Width="75"/>
        <Button x:Name="btnRemoveAllCmd" Content="清空命令" Click="btnRemoveAllCmd_Click" HorizontalAlignment="Left" Margin="165,48,0,0" VerticalAlignment="Top" Width="75"/>
        <DataGrid x:Name="gridCmds" HorizontalAlignment="Left" Height="243" Margin="85,74,0,0" VerticalAlignment="Top" Width="641" AutoGenerateColumns="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="命令名称" Binding="{Binding CmdName}" Width="100"/>
                <DataGridTextColumn Header="命令参数" Binding="{Binding CmdInVoJson}" Width="200"/>
                <!-- 操作按钮列 -->
                <DataGridTemplateColumn Header="操作" Width="200">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="编辑" 
                                        Click="btnEditCmd_Click" 
                                        Padding="5,2"
                                        Margin="2"
                                        Tag="{Binding}"
                                        Background="#3498DB"
                                        Foreground="White"/>

                                <Button Content="复制" 
                                        Click="btnCopyCmd_Click" 
                                        Padding="5,2"
                                        Margin="2"
                                        Tag="{Binding}"
                                        Background="#E74C3C"
                                        Foreground="White"/>

                                <Button Content="删除" 
                                        Click="btnRemoveCmd_Click" 
                                        Padding="5,2"
                                        Margin="2"
                                        Tag="{Binding}"
                                        Background="#27AE60"
                                        Foreground="White"/>

                                <Button Content="上移" 
                                        Click="btnMoveUpCmd_Click" 
                                        Padding="5,2"
                                        Margin="2"
                                        Tag="{Binding}"
                                        Background="#27AE60"
                                        Foreground="White"/>

                                <Button Content="下移" 
                                        Click="btnMoveDownCmd_Click" 
                                        Padding="5,2"
                                        Margin="2"
                                        Tag="{Binding}"
                                        Background="#27AE60"
                                        Foreground="White"/>

                                <Button Content="执行" 
                                        Click="btnDebugCmd_Click" 
                                        Padding="5,2"
                                        Margin="2"
                                        Tag="{Binding}"
                                        Background="#27AE60"
                                        Foreground="White"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
        <Label Content="子步骤:" HorizontalAlignment="Left" Margin="10,325,0,0" VerticalAlignment="Top"/>
        <Button x:Name="btnAddStep" Content="添加步骤" Click="btnAddStep_Click" HorizontalAlignment="Left" Margin="85,329,0,0" VerticalAlignment="Top" Width="75"/>
        <Button x:Name="btnRemoveAllStep" Content="清空步骤" Click="btnRemoveAllStep_Click" HorizontalAlignment="Left" Margin="165,329,0,0" VerticalAlignment="Top" Width="75"/>
        <DataGrid x:Name="gridSteps" HorizontalAlignment="Left" Height="264" Margin="85,359,0,0" VerticalAlignment="Top" Width="641" AutoGenerateColumns="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="步骤名称" Binding="{Binding Name}" Width="200"/>
                <!-- 操作按钮列 -->
                <DataGridTemplateColumn Header="操作" Width="200">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="编辑" 
                                        Click="btnEditStep_Click" 
                                        Padding="5,2"
                                        Margin="2"
                                        Tag="{Binding}"
                                        Background="#3498DB"
                                        Foreground="White"/>

                                <Button Content="复制" 
                                        Click="btnCopyStep_Click" 
                                        Padding="5,2"
                                        Margin="2"
                                        Tag="{Binding}"
                                        Background="#E74C3C"
                                        Foreground="White"/>

                                <Button Content="删除" 
                                        Click="btnRemoveStep_Click" 
                                        Padding="5,2"
                                        Margin="2"
                                        Tag="{Binding}"
                                        Background="#27AE60"
                                        Foreground="White"/>

                                <Button Content="上移" 
                                        Click="btnMoveUpStep_Click" 
                                        Padding="5,2"
                                        Margin="2"
                                        Tag="{Binding}"
                                        Background="#27AE60"
                                        Foreground="White"/>

                                <Button Content="下移" 
                                        Click="btnMoveDownStep_Click" 
                                        Padding="5,2"
                                        Margin="2"
                                        Tag="{Binding}"
                                        Background="#27AE60"
                                        Foreground="White"/>

                                <Button Content="执行" 
                                        Click="btnDebugStep_Click" 
                                        Padding="5,2"
                                        Margin="2"
                                        Tag="{Binding}"
                                        Background="#27AE60"
                                        Foreground="White"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
        <Button x:Name="btnOk" Content="确定" Click="btnOk_Click" HorizontalAlignment="Left" Margin="217,643,0,0" VerticalAlignment="Top" Width="75"/>
        <Button x:Name="btnCancel" Content="取消" Click="btnCancel_Click" HorizontalAlignment="Left" Margin="400,643,0,0" VerticalAlignment="Top" Width="75"/>
    </Grid>
</Window>
