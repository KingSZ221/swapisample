<Window x:Class="swapiapp.ui.usecase.SwUseCaseInfoPanel"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:swapiapp.ui.usecase"
        mc:Ignorable="d"
        Title="新增用例" Height="730" Width="760">
    <Grid>
        <Label Content="ID:" HorizontalAlignment="Left" Margin="15,10,0,0" VerticalAlignment="Top"/>
        <TextBox x:Name="txtId" HorizontalAlignment="Left" Height="23" Margin="91,10,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="629" IsReadOnly="True"/>
        <Label Content="名称:" HorizontalAlignment="Left" Margin="15,43,0,0" VerticalAlignment="Top"/>
        <TextBox x:Name="txtName" HorizontalAlignment="Left" Height="23" Margin="91,43,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="629"/>
        <Label Content="描述:" HorizontalAlignment="Left" Margin="15,73,0,0" VerticalAlignment="Top"/>
        <TextBox x:Name="txtDesc" HorizontalAlignment="Left" Height="23" Margin="91,73,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="629"/>
        <Label Content="组:" HorizontalAlignment="Left" Margin="15,107,0,0" VerticalAlignment="Top"/>
        <TextBox x:Name="txtGroup" HorizontalAlignment="Left" Height="23" Margin="91,107,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="629"/>
        <Label Content="步骤:" HorizontalAlignment="Left" Margin="16,140,0,0" VerticalAlignment="Top"/>
        <Button x:Name="btnAddStep" Content="添加步骤" Click="btnAdd_Click" HorizontalAlignment="Left" Margin="91,140,0,0" VerticalAlignment="Top" Width="75"/>
        <Button x:Name="btnRemoveAllStep" Content="清空步骤" Click="btnRemoveAll_Click" HorizontalAlignment="Left" Margin="171,140,0,0" VerticalAlignment="Top" Width="75"/>
        <DataGrid x:Name="gridSteps" HorizontalAlignment="Left" Height="471" Margin="91,172,0,0" VerticalAlignment="Top" Width="641" AutoGenerateColumns="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="步骤名称" Binding="{Binding Name}" Width="200"/>
                <!-- 操作按钮列 -->
                <DataGridTemplateColumn Header="操作" Width="200">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="编辑" 
                                        Click="btnEdit_Click" 
                                        Padding="5,2"
                                        Margin="2"
                                        Tag="{Binding}"
                                        Background="#3498DB"
                                        Foreground="White"/>

                                <Button Content="复制" 
                                        Click="btnCopy_Click" 
                                        Padding="5,2"
                                        Margin="2"
                                        Tag="{Binding}"
                                        Background="#3498DB"
                                        Foreground="White"/>

                                <Button Content="删除" 
                                        Click="btnRemove_Click" 
                                        Padding="5,2"
                                        Margin="2"
                                        Tag="{Binding}"
                                        Background="#E74C3C"
                                        Foreground="White"/>

                                <Button Content="上移" 
                                        Click="btnMoveUp_Click" 
                                        Padding="5,2"
                                        Margin="2"
                                        Tag="{Binding}"
                                        Background="#27AE60"
                                        Foreground="White"/>

                                <Button Content="下移" 
                                        Click="btnMoveDown_Click" 
                                        Padding="5,2"
                                        Margin="2"
                                        Tag="{Binding}"
                                        Background="#27AE60"
                                        Foreground="White"/>

                                <Button Content="执行" 
                                        Click="btnDebug_Click" 
                                        Padding="5,2"
                                        Margin="2"
                                        Tag="{Binding}"
                                        Background="#27AE60"
                                        Foreground="White"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
        <Button x:Name="btnOk" Content="确定" Click="btnOk_Click" HorizontalAlignment="Left" Margin="218,661,0,0" VerticalAlignment="Top" Width="75"/>
        <Button x:Name="btnCancel" Content="取消" Click="btnCancel_Click" HorizontalAlignment="Left" Margin="401,661,0,0" VerticalAlignment="Top" Width="75"/>
    </Grid>
</Window>
