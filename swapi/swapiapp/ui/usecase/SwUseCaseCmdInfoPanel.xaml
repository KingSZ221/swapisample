<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:swapiapp.ui.usecase"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit" x:Class="swapiapp.ui.usecase.SwUseCaseCmdInfoPanel"
        mc:Ignorable="d"
        Title="添加命令" Height="670" Width="730">
    <Grid Margin="0,0,0,0">
        <Label Content="模块:" HorizontalAlignment="Left" Margin="18,13,0,0" VerticalAlignment="Top"/>
        <ComboBox x:Name="comboBoxModule" 
            SelectionChanged="comboBoxModule_SelectionChanged"  HorizontalAlignment="Left" Margin="88,13,0,0" VerticalAlignment="Top" Width="618"/>
        <Label Content="名称:" HorizontalAlignment="Left" Margin="18,42,0,0" VerticalAlignment="Top"/>
        <Label Content="参数:" HorizontalAlignment="Left" Margin="19,69,0,0" VerticalAlignment="Top"/>
        <ComboBox x:Name="comboBoxCmd" 
                  DisplayMemberPath="CmdTypeName"
                  SelectedValuePath="CmdTypeId"
                  SelectionChanged="comboBoxCmd_SelectionChanged" HorizontalAlignment="Left" Margin="88,42,0,0" VerticalAlignment="Top" Width="618"/>

        <xctk:PropertyGrid x:Name="propertyGridCmd" Margin="88,77,17.2,54.8"/>
        <Button x:Name="btnOk" Content="确定" Click="btnOk_Click" HorizontalAlignment="Left" Margin="234,599,0,0" VerticalAlignment="Top" Width="75"/>
        <Button x:Name="btnCancel" Content="取消" Click="btnCancel_Click" HorizontalAlignment="Left" Margin="417,599,0,0" VerticalAlignment="Top" Width="75"/>
    </Grid>
</Window>
